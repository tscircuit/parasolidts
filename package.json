{
  "name": "parasolidts",
  "version": "0.0.1",
  "description": "TypeScript parser and serializer for Parasolid text files",
  "type": "module",
  "module": "lib/index.ts",
  "main": "lib/index.ts",
  "types": "lib/index.ts",
  "exports": {
    ".": "./lib/index.ts"
  },
  "files": [
    "lib",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": "https://github.com/tscircuit/parasolidts",
